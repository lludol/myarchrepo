pkgname=notion-app-electron
pkgver=7.44.1
_bettersqlite3ver=13.0.1 # match node_modules/better-sqlite3 in app.asar; 13.x ships N-API prebuilds (Electron-ABI independent)
_bufferutilver=4.0.9
_electronver=45.3.1 # match "electron" in app.asar package.json; Arch has no electron45, so bundle upstream build
pkgrel=3
pkgdesc="Your connected workspace for wiki, docs & projects"
arch=(x86_64)
url=https://www.notion.so/desktop
license=(custom)
depends=(
	bash
	gcc-libs
	glibc
	hicolor-icon-theme
	alsa-lib
	gtk3
	nss
)
makedepends=(
	p7zip
	asar
)
install=.install

source=(
	https://desktop-release.notion-static.com/Notion%20Setup%20${pkgver}.exe
	https://registry.npmjs.org/better-sqlite3/-/better-sqlite3-${_bettersqlite3ver}.tgz
	https://github.com/electron/electron/releases/download/v${_electronver}/electron-v${_electronver}-linux-x64.zip
	https://github.com/websockets/bufferutil/releases/download/v${_bufferutilver}/v${_bufferutilver}-linux-x64.tar
	notion-app
	notion.desktop
	notion.png
)
sha256sums=('d287a31c78b706e18327d43fce511d9a26fef458cb0187d2a6ff6308b1618f3e'
            '92935ff8280f933aff78f87e04eb718a21af003aec4e5bd0076f287aa1709da4'
            'c61d44206f8bd533d30310840b5baaa7fd0e8421cd711b8d1f719a7a336cbce7'
            '2139aae79c5a4fd4d07467bd9b7872ea109483aa43b3dfd6c8d3725ccba009be'
            '0b9b8bd699f2cd2727a294f5b9564bb1a9e5a42af2438a6d05687d5e571d9ef3'
            '19a5f973f1e9291081aa05512e07c61447e8c30e1a43dd22d0cc1090837d1e19'
            'da801d659d8916320e0d76c8c62154e97a1d44f71762f2a18d1c8c185624d5be')

noextract=(electron-v${_electronver}-linux-x64.zip)
options=(!emptydirs !strip !debug)

prepare() {
	# extracting app.asar from installer with 7z and ignoring errors
	7z x "./Notion%20Setup%20${pkgver}.exe" "\$PLUGINSDIR/app-64.7z" -y -bse0 -bso0 || true
	7z x "./\$PLUGINSDIR/app-64.7z" "resources/app.asar" "resources/app.asar.unpacked" -y -bse0 -bso0 || true
	rm "./Notion%20Setup%20${pkgver}.exe"
	rm "./\$PLUGINSDIR/app-64.7z"
	# extracting resources from app.asar
	asar e "$srcdir/resources/app.asar" "$srcdir/asar_patched"
	# replacing better_sqlite3 release in the patched resources
	install -vDm644 "$srcdir/package/prebuilds/linux-x64.node" -t "$srcdir/asar_patched/node_modules/better-sqlite3/prebuilds/"
	install -vDm644 "$srcdir/package/prebuilds/linux-x64.node" "$srcdir/asar_patched/node_modules/better-sqlite3/build/Release/better_sqlite3.node"
	# bundled electron
	mkdir -p "$srcdir/electron"
	bsdtar -xf "$srcdir/electron-v${_electronver}-linux-x64.zip" -C "$srcdir/electron"
	# replacing bufferutil release in the patched resources
	install -vDm644 "$srcdir/linux-x64/bufferutil.node" "$srcdir/asar_patched/node_modules/bufferutil/build/Release/bufferutil.node"
	# removing some unnecessary files (keeping them in this version to see if it improves stability)
	# rm "$srcdir/asar_patched/node_modules/node-mac-window" -r
	# rm "$srcdir/asar_patched/node_modules/better-sqlite3/build/Release/test_extension.node"
	# adding tray icon to the unpacked resources
	install -vDm644 "$srcdir/notion.png" "$srcdir/asar_patched/.webpack/main/trayIcon.png"

	# --- patches to the minified main process ---
	# Every patch must match, otherwise the build fails: minified code changes between
	# Notion releases and a silently skipped patch (or a half-matched one) breaks the app.
	local js="$srcdir/asar_patched/.webpack/main/index.js"
	_patch() { # literal search/replace, fails if the search string is absent
		grep -qF -- "$1" "$js" || { error "Notion patch target not found: $1"; return 1; }
		SEARCH="$1" REPLACE="$2" perl -0777 -pi -e 's/\Q$ENV{SEARCH}\E/$ENV{REPLACE}/g' "$js"
	}

	# use our tray icon (upstream looks for it in process.resourcesPath, which is the bundled electron dir).
	# getIcon() body has nested braces (template literals), so match balanced braces.
	perl -0777 -pi -e 's/getIcon\(\)(\{(?:[^{}]++|(?1))*\})/getIcon(){return require("path").resolve(__dirname, "trayIcon.png");}/g' "$js"
	grep -qF 'getIcon(){return require("path").resolve(__dirname, "trayIcon.png");}' "$js" || { error "Notion patch failed: getIcon"; return 1; }
	# fake the useragent as windows to fix the spellchecker languages selector and other issues
	_patch 'e.setUserAgent(`${e.getUserAgent()} WantsServiceWorker`),' \
		'e.setUserAgent(`${e.getUserAgent().replace("Linux", "Windows")} WantsServiceWorker`),'
	# use the windows version of the tray menu (app items + troubleshooting submenu)
	_patch 'return"win32"===process.platform?[T(e,t)]:' 'return"linux"===process.platform?[T(e,t)]:'
	_patch 'o="win32"===process.platform?[{type:"separator"},...(0,y.filterMenuByKind)(' \
		'o="linux"===process.platform?[{type:"separator"},...(0,y.filterMenuByKind)('

	# No longer needed as of 7.44 (handled upstream on linux):
	# - tray right-click menu: upstream calls tray.setContextMenu() on linux
	# - auto updates: upstream disables them on linux unless running as a Flatpak
	# - single instance / notion:// url opening: upstream has a linux requestSingleInstanceLock + second-instance handler

	# this can disable app menu when the options won't work. disabled in the current version because it's working now, but it's here for future reference
	# _patch 'Menu.setApplicationMenu(p(e))' 'Menu.setApplicationMenu(null)'

	# catch any patch that produced invalid JS (node comes with asar)
	node --check "$js"
	# repacking asar with all the patches
	asar p "$srcdir/asar_patched" "$srcdir/app.asar" --unpack *.node
}

package() {
	local usr="$pkgdir/usr"
	local share="$usr/share"
	local lib="$usr/lib/notion-app"

	install -d "$lib"
	cp "$srcdir/app.asar" "$lib"
	cp "$srcdir/app.asar.unpacked" "$lib" -r
	cp -r "$srcdir/electron" "$lib/electron"
	install -vDm644 "$srcdir/asar_patched/package.json" "$lib/package.json"
	install -vDm755 notion-app -t "$usr/bin"
	install -vDm644 "$srcdir/notion.desktop" -t "$share/applications"
	install -vDm644 "$srcdir/notion.png" -t "$share/icons/hicolor/256x256/apps"
}
