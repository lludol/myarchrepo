pkgname=hermes-desktop
pkgver=0.22.5
pkgrel=1
pkgdesc='Native Hermes Agent desktop client (supports remote gateways)'
arch=('x86_64')
url='https://hermes-agent.nousresearch.com/desktop'
license=('MIT')
depends=(
  'electron44'
)
makedepends=(
  'nodejs'
  'npm'
  'python'
)
optdepends=(
  'org.freedesktop.secrets: securely store remote gateway credentials'
)
options=('!debug')

_tag='v0.22.5'
_electronver='44.9.3'
_commit='bf0203a794a07aac3ff764972ab9087baa4e4f4e'
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/NousResearch/hermes-agent/archive/refs/tags/${_tag}.tar.gz"
  "electron-headers-${_electronver}.tar.gz::https://www.electronjs.org/headers/v${_electronver}/node-v${_electronver}-headers.tar.gz"
  'hermes-desktop'
  'hermes-desktop.desktop'
)
sha256sums=('a8f67e5ec14fea681acef6cc7ff1553f002bb6101fd2df22bfdd4b7eecc54eb2'
            '5f75ae1e70e69442c9d23f7d984e8ca211e49c5bee2298ca2d84d3c75c640710'
            '4ec069db1324377ded973403671dec9f5ad805ec33940976829463d16259c252'
            '540c3afcdaca4ecb266a7db1b79e6d5cbdef2944fffd056d85064b9eea2c5fdd')

prepare() {
  cd "hermes-agent-${_tag#v}"

  # Keep dependency installation non-interactive and avoid downloading the
  # bundled Electron runtime; the package uses Arch's electron40 instead.
  npm ci --ignore-scripts --cache "${srcdir}/npm-cache"

  # get-windows is optional and has no Linux build. Leaving its binding.gyp in
  # node_modules makes electron-rebuild attempt (and fail) to compile it.
  rm -rf node_modules/get-windows
}

build() {
  cd "hermes-agent-${_tag#v}"

  # node-pty must be compiled for Electron's ABI. The separately checksummed
  # headers keep this step offline and reproducible.
  export npm_config_nodedir="${srcdir}/node_headers"
  export GITHUB_SHA="${_commit}"
  npm run build --workspace apps/desktop

  # This source-build freshness receipt is not used by packaged clients and
  # contains absolute paths from the temporary build directory.
  rm -f apps/desktop/dist/hermes-build.json

  cd apps/desktop

  # Upstream's builder wrapper only admits Electron archives copied into its
  # prepared-input directory. This package deliberately builds the app bundle
  # against Arch's unpacked Electron distribution instead, so invoke the
  # lock-pinned builder directly while retaining upstream's config and hooks.
  NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--max-old-space-size=16384" \
    node ../../node_modules/electron-builder/cli.js \
      --linux --dir --config electron-builder.config.cjs --publish never \
      -c.electronDist=/usr/lib/electron44
}

package() {
  cd "hermes-agent-${_tag#v}"

  local resources='apps/desktop/release/linux-unpacked/resources'
  install -d "${pkgdir}/usr/lib/${pkgname}"
  install -m644 "${resources}/app.asar" \
    "${pkgdir}/usr/lib/${pkgname}/app.asar"
  cp -r "${resources}/app.asar.unpacked" \
    "${pkgdir}/usr/lib/${pkgname}/app.asar.unpacked"

  # electron-builder copies node-gyp intermediates next to the native addon.
  # They are unnecessary at runtime and leak the temporary build path.
  local pty_release="${pkgdir}/usr/lib/${pkgname}/app.asar.unpacked/dist/node_modules/node-pty/build/Release"
  rm -rf "${pty_release}/.deps" "${pty_release}/node-addon-api" \
    "${pty_release}/obj.target"
  rm -f "${pty_release}/.forge-meta"

  install -Dm755 "${srcdir}/hermes-desktop" \
    "${pkgdir}/usr/bin/hermes-desktop"
  install -Dm644 "${srcdir}/hermes-desktop.desktop" \
    "${pkgdir}/usr/share/applications/hermes-desktop.desktop"
  install -Dm644 apps/desktop/assets/icon.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/hermes-desktop.png"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
