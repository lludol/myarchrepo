_pkgname="tradingview"
pkgname="$_pkgname"
pkgver=3.5.1
pkgrel=2
pkgdesc='Charting platform for traders and investors'
arch=('x86_64')
url="https://www.tradingview.com/desktop/"
license=('LicenseRef-TradingView')

# ships its own Electron (snap bundles Electron 45; native modules need its ABI)
depends=(
  'alsa-lib'
  'gtk3'
  'libsecret'
  'nss'
)
makedepends=(
  'html-xml-utils'
  'sha3sum'
  'squashfs-tools'
  'w3m'
)

options=('!debug' '!strip')

_terms_of_use="$_pkgname-eula"
_pkgsrc="$_pkgname-$pkgver"
source=(
  "$_pkgsrc.snap"::"https://api.snapcraft.io/api/v1/snaps/download/nJdITJ6ZJxdvfu8Ch7n5kH5P99ClzBYV_76.snap"
  "$_terms_of_use.html"::"https://www.tradingview.com/policies/"
)
sha256sums=(
  '2ac163d8472dce037b923982d96d699389eb32f566a74deacd4cb0109cb817d2'
  'SKIP'
)

prepare() {
  hxextract .tv-policies "$_terms_of_use.html" \
    1> "$_terms_of_use-2.html" \
    2> /dev/null

  w3m -O UTF-8 -cols 80 -dump "$_terms_of_use-2.html" > "$_terms_of_use.txt"

  # unpack
  mkdir -p "$_pkgsrc"
  unsquashfs -q -n -f -d "$_pkgsrc/" "$_pkgsrc.snap"
}

package() {
  # app (bundled electron)
  install -dm755 "$pkgdir/opt/$_pkgname"
  cp -r --no-preserve=ownership \
    "$_pkgsrc/"{locales,resources,"$_pkgname",chrome_crashpad_handler,*.pak,*.bin,*.dat,*.so,*.so.*,vk_swiftshader_icd.json} \
    "$pkgdir/opt/$_pkgname/"

  # launcher
  sed -E -e '/^Comment=/d' \
    -e 's&^(Icon)=.*$&\1='"$_pkgname&" \
    -e 's&^(Categories)=(Finance;)$&\1=Office;\2&' \
    -i "$_pkgsrc/meta/gui/$_pkgname.desktop"

  install -Dm644 "$_pkgsrc/meta/gui/$_pkgname.desktop" -t "$pkgdir/usr/share/applications/"

  # icon
  install -Dm644 "$_pkgsrc/meta/gui/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_pkgname.png"

  # license
  install -Dm644 "$_terms_of_use.txt" -t "$pkgdir/usr/share/licenses/$pkgname/"

  # script
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_pkgname" << END
#!/usr/bin/env bash

name=$_pkgname
flags_file="\${XDG_CONFIG_HOME:-\$HOME/.config}/\${name}-flags.conf"

lines=()
if [[ -f "\${flags_file}" ]]; then
  mapfile -t lines < "\${flags_file}"
fi

flags=()
for line in "\${lines[@]}"; do
  if [[ ! "\${line}" =~ ^[[:space:]]*#.* ]] && [[ -n "\${line}" ]]; then
    flags+=("\${line}")
  fi
done

: \${ELECTRON_IS_DEV:=0}
export ELECTRON_IS_DEV
: \${ELECTRON_FORCE_IS_PACKAGED:=true}
export ELECTRON_FORCE_IS_PACKAGED

exec "/opt/$_pkgname/$_pkgname" "\${flags[@]}" "\$@"
END
}
